#!/usr/bin/env python3
"""Preserve Caldir pre-0.13.1 Google default-reminder semantics on upgrade."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent
MARKER = "X-GOOGLE-DEFAULT-REMINDERS:TRUE"


def config() -> dict:
    caldir = SCRIPT_DIR / "calendar-caldir"
    try:
        result = subprocess.run(
            [str(caldir), "config", "--json"], check=True, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        return json.loads(result.stdout)["config"]
    except (OSError, subprocess.CalledProcessError, KeyError, json.JSONDecodeError):
        # A runtime-only setup can legitimately precede the first connection.
        return {}


def is_google_calendar(path: Path) -> bool:
    config_file = path / ".caldir" / "config.toml"
    if not config_file.is_file():
        return False
    return bool(re.search(r'(?m)^provider\s*=\s*"google"\s*$', config_file.read_text(encoding="utf-8")))


def property_name(line: str) -> str:
    return line.split(":", 1)[0].split(";", 1)[0].upper()


def add_default_reminder_markers(path: Path) -> bool:
    lines = path.read_text(encoding="utf-8").replace("\r\n", "\n").splitlines()
    output: list[str] = []
    event: list[str] | None = None
    changed = False

    for line in lines:
        upper = line.upper()
        if upper == "BEGIN:VEVENT":
            event = [line]
            continue
        if event is None:
            output.append(line)
            continue
        if upper != "END:VEVENT":
            event.append(line)
            continue

        names = {property_name(item) for item in event}
        has_alarm = any(item.upper() == "BEGIN:VALARM" for item in event)
        # Older Caldir treated no VALARM as "use Google defaults". Do not
        # overwrite explicit per-event alarms or a marker already written by
        # a current runtime.
        if not has_alarm and "X-GOOGLE-DEFAULT-REMINDERS" not in names:
            event.append(MARKER)
            changed = True
        output.extend(event)
        output.append(line)
        event = None

    if event is not None:
        raise ValueError("unterminated VEVENT")
    if not changed:
        return False

    payload = ("\r\n".join(output) + "\r\n").encode("utf-8")
    descriptor, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, path.stat().st_mode & 0o777)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return True


def main() -> int:
    settings = config()
    calendar_dir = settings.get("calendar_dir")
    if not isinstance(calendar_dir, str) or not calendar_dir:
        return 0
    root = Path(calendar_dir).expanduser()
    if not root.is_dir():
        return 0

    changed = 0
    for calendar in root.iterdir():
        if calendar.is_dir() and is_google_calendar(calendar):
            for event in calendar.glob("*.ics"):
                if add_default_reminder_markers(event):
                    changed += 1
    if changed:
        print(f"Preserved Google default reminders for {changed} local event(s).")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, UnicodeError, ValueError) as error:
        print(f"Could not preserve Google reminder settings: {error}", file=sys.stderr)
        raise SystemExit(1)
