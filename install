#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ID="omarchy-google-calendar-clock"
BUILTIN_ID="omarchy.clock"
PLUGIN_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/omarchy/plugins/${PLUGIN_ID}"
REPOSITORY_URL=""

SETUP_ARGS=()

while (( $# > 0 )); do
  case "$1" in
  --hosted)
    SETUP_ARGS+=(--hosted)
    shift
    ;;
  -h|--help)
    cat <<'EOF'
Usage: install <https://github.com/owner/repository.git> [--hosted]

Installs Omarchy Google Calendar and Clock and runs setup. Pass --hosted to
use caldir.org's hosted Google OAuth relay instead of your own Google Cloud
OAuth client; see the setup script for the trade-off.
EOF
    exit 0
    ;;
  -*)
    echo "Unknown install option: $1" >&2
    echo "Usage: install <https://github.com/owner/repository.git> [--hosted]" >&2
    exit 64
    ;;
  *)
    [[ -z "$REPOSITORY_URL" ]] || { echo "Unexpected argument: $1" >&2; exit 64; }
    REPOSITORY_URL=$1
    shift
    ;;
  esac
done

[[ -n "$REPOSITORY_URL" ]] || {
  echo "Usage: install <https://github.com/owner/repository.git> [--hosted]" >&2
  exit 64
}

for dependency in omarchy jq; do
  command -v "$dependency" >/dev/null || { echo "Missing required command: ${dependency}" >&2; exit 127; }
done

added=false
cleanup_failed_install() {
  status=$?
  if (( status != 0 )) && $added; then
    if (( status == 75 )); then
      echo "The plugin remains installed but disabled so setup can be retried safely." >&2
    else
      omarchy plugin remove "$PLUGIN_ID" --yes >/dev/null 2>&1 || true
    fi
  fi
  exit "$status"
}
trap cleanup_failed_install EXIT

if [[ -e "$PLUGIN_DIR" ]]; then
  echo "${PLUGIN_ID} is already installed; its existing checkout will be used."
else
  omarchy plugin add "$REPOSITORY_URL" --yes
  added=true
fi

set +e
"${PLUGIN_DIR}/setup" "${SETUP_ARGS[@]}"
setup_status=$?
set -e
if (( setup_status != 0 )); then exit "$setup_status"; fi

added=false
echo
echo "Omarchy Google Calendar and Clock is installed, connected, enabled, and centered."
